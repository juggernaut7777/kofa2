# =============================================
# KOFA Environment Variables
# Copy to .env and fill in your values:
#   copy .env.example .env
# =============================================

# ---- DATABASE (REQUIRED — pick MySQL OR SQL Server) ----
# Set DB_TYPE to "mysql" or "sqlserver"
DB_TYPE=mysql

# MySQL (Azure MySQL)
MYSQL_HOST=kofa-mysql.mysql.database.azure.com
MYSQL_USER=your_mysql_username
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=kofa
MYSQL_PORT=3306

# SQL Server (Azure SQL) — uncomment if using SQL Server
# DB_TYPE=sqlserver
# DB_SERVER=kofa-server-bane.database.windows.net
# DB_USER=your_sql_username
# DB_PASSWORD=your_sql_password
# DB_NAME=Kofa-db
# DB_PORT=1433

# ---- AI (REQUIRED for chatbot) ----
GROQ_API_KEY=your_groq_api_key

# ---- SECURITY ----
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
JWT_SECRET_KEY=change-this-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
WHATSAPP_VERIFY_TOKEN=your-random-verify-token

# Encryption key for bank details (generate with command below)
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KOFA_ENCRYPTION_KEY=

# ---- PAYMENTS ----
PAYSTACK_SECRET_KEY=sk_test_xxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxx
PAYSTACK_WEBHOOK_SECRET=

# ---- WHATSAPP ----
WHATSAPP_PHONE_ID=
WHATSAPP_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=

# ---- OPTIONAL ----
EXCHANGE_RATE_API_KEY=
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
