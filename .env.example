# =============================================
# KOFA Environment Variables
# Copy to .env and fill in your values:
#   copy .env.example .env
# =============================================

# ---- DATABASE CONFIGURATION ----
# Option 1: Standard DATABASE_URL (Recommended for Supabase, Neon, Render, Railway)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Option 2: Local SQLite (Zero-cost, immediate local testing)
DB_TYPE=sqlite
SQLITE_PATH=kofa.db

# Option 3: PostgreSQL (Self-hosted or cloud)
# DB_TYPE=postgres
# PG_HOST=localhost
# PG_USER=postgres
# PG_PASSWORD=your_password
# PG_DATABASE=kofa
# PG_PORT=5432

# Option 4: MySQL
# DB_TYPE=mysql
# MYSQL_HOST=localhost
# MYSQL_USER=root
# MYSQL_PASSWORD=your_password
# MYSQL_DATABASE=kofa
# MYSQL_PORT=3306

# ---- AI (REQUIRED for chatbot) ----
GROQ_API_KEY=your_groq_api_key

# ---- SECURITY ----
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
JWT_SECRET_KEY=change-this-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
WHATSAPP_VERIFY_TOKEN=your-random-verify-token

# Encryption key for bank details (generate with command below)
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KOFA_ENCRYPTION_KEY=

# ---- PAYMENTS ----
PAYSTACK_SECRET_KEY=sk_test_xxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxx
PAYSTACK_WEBHOOK_SECRET=

# ---- WHATSAPP ----
WHATSAPP_PHONE_ID=
WHATSAPP_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=

# ---- OPTIONAL ----
EXCHANGE_RATE_API_KEY=
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
